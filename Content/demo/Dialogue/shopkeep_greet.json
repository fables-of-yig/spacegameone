{
  "_comment": "Phase 5d demo dialogue. Shopkeeper greeting with shop-style choice branches expressed as trigger actions instead of a dedicated shop UI — give_item + take_item + add_var actions implement the transaction.",
  "id": "shopkeep_greet",
  "lines": [
    {
      "speaker": "Shopkeeper",
      "text": "Welcome to MVMania, traveller!"
    },
    {
      "speaker": "Shopkeeper",
      "text": "What'll it be?",
      "choices": [
        {
          "text": "Buy Potion (10 coins)",
          "condition": { "type": "var_gte", "name": "gold", "value": 10 },
          "actions": [
            { "type": "add_var", "name": "gold", "delta": -10 },
            { "type": "give_item", "id": "potion", "count": 1 },
            { "type": "play_sfx", "name": "buy" }
          ]
        },
        {
          "text": "Buy Silver Key (50 coins)",
          "condition": { "type": "var_gte", "name": "gold", "value": 50 },
          "actions": [
            { "type": "add_var", "name": "gold", "delta": -50 },
            { "type": "give_item", "id": "key_silver", "count": 1 },
            { "type": "play_sfx", "name": "buy" }
          ]
        },
        {
          "text": "Sell Potion (5 coins)",
          "condition": { "type": "has_item", "id": "potion", "min_count": 1 },
          "actions": [
            { "type": "take_item", "id": "potion", "count": 1 },
            { "type": "add_var", "name": "gold", "delta": 5 },
            { "type": "play_sfx", "name": "sell" }
          ]
        },
        {
          "text": "Leave",
          "actions": [
            { "type": "end_dialogue" }
          ]
        }
      ]
    },
    {
      "speaker": "Shopkeeper",
      "text": "Come back any time."
    }
  ]
}
