{
  "meta": {
    "name": "SCS Meridian Tactical HUD",
    "design_resolution": { "w": 1920, "h": 1080 },
    "letterbox_color": "#000000",
    "notes": "All positions are absolute in the 1920×1080 design canvas. Scale to viewport with letterbox."
  },

  "colors": {
    "hud":     { "value": "hsl(188, 95%, 67%)", "role": "primary accent — tintable HUD color", "tweakable": true },
    "hud_dim": { "value": "hsl(188, 55%, 38%)", "role": "secondary accent / dimmed strokes",  "tweakable": true },
    "hud_deep":{ "value": "hsl(188, 60%, 18%)", "role": "deep accent / inner glow",           "tweakable": true },
    "warn":    { "value": "#ffb14a", "role": "muzzle flash / firing / warning" },
    "danger":  { "value": "#ff4a5e", "role": "hostile contact / hull critical" },
    "ok":      { "value": "#6cf08a", "role": "ready state / nominal hull" },
    "ink":     { "value": "#061015", "role": "panel ink / button background" },
    "panel":   { "value": "rgba(8, 22, 30, 0.72)", "role": "panel fill" },
    "grid":    { "value": "rgba(92, 242, 255, 0.08)", "role": "background grid" },
    "bg_deep": { "value": "#02060b", "role": "space background — outer" },
    "bg_mid":  { "value": "#061a26", "role": "space background — inner" },

    "chassis": {
      "hull_dark":   "#04141a",
      "hull_mid":    "#06212a",
      "hull_warm":   "#0c3a48",
      "hull_panel":  "#0e3744",
      "hull_light":  "#1a4c5c",
      "barrel_hot":  "#1a6878"
    },
    "missile": {
      "warhead":  "#e9eef0",
      "body_top": "#d8e8ee",
      "body_mid": "#7a99a4",
      "body_bot": "#2e4a55",
      "fin":      "#56707b",
      "exhaust_outer": "#ffb14a",
      "exhaust_inner": "#fff5cc"
    },
    "enemy": {
      "hull_top": "#3a1820",
      "hull_bot": "#7a1f2e",
      "wing":     "#5a1822",
      "cockpit_outer": "#ffb14a",
      "cockpit_inner": "#fff5cc",
      "outline":  "#ff4a5e"
    },

    "_tinting": {
      "strategy": "Each sprite SVG splits children into two groups by class: `.chassis` (baked dark hull, do NOT recolor) and `.tint` (the HUD accent, recolor at runtime). The accent is baked as #5cf2ff for preview; in engine, recolor the .tint group by either (a) editing the SVG before import, (b) using a CanvasItem `modulate` on a white version of the accent layer, or (c) using a hue-shift shader on the whole sprite."
    }
  },

  "hud_geometry_1920x1080": {
    "shield_parry":  { "anchor": "top-left",    "x": 38,   "y": 38,   "w": 240, "h": 240 },
    "minimap":       { "anchor": "top-right",   "x": -38,  "y": 38,   "w": 360, "h": 360 },
    "pulse_readout": { "anchor": "bottom-left", "x": 38,   "y": -80,  "w": 360, "h": 192 },
    "torpedo_readout":{ "anchor": "bottom-right","x": -38, "y": -80,  "w": 360, "h": 192 },
    "gauss_readout": { "anchor": "bottom-center","x": 0,   "y": -80,  "w": 1060,"h": 78  },
    "status_bars":   { "anchor": "bottom-center","x": 0,   "y": -18,  "w": 1700,"h": 56  },
    "reticle":       { "anchor": "center",      "x": 0,    "y": 0,    "w": 220, "h": 220 },
    "frame_inset":   24,
    "_note": "anchor `-` means the value is an offset from the opposite edge (e.g. minimap.x=-38 means 38px from the right). `bottom-center.x=0` means horizontally centered."
  },

  "panels": {
    "border_color": "{colors.hud_dim}",
    "background":   "{colors.panel}",
    "inset_glow":   "inset 0 0 24px rgba(92,242,255,0.08)",
    "outer_shadow": "0 0 24px rgba(0,0,0,0.5)",
    "corner_cut":   14,
    "_corner_cut_polygon": "polygon(14px 0, calc(100% - 14px) 0, 100% 14px, 100% calc(100% - 14px), calc(100% - 14px) 100%, 14px 100%, 0 calc(100% - 14px), 0 14px)"
  },

  "typography": {
    "primary": {
      "family": "RobynPulp",
      "url": "fonts/RobynPulpSciFi-Regular.ttf",
      "fallback": "JetBrains Mono, monospace",
      "all_caps": true
    },
    "scales": {
      "label_md":   { "size": 13, "tracking": "0.14em" },
      "label_lg":   { "size": 18, "tracking": "0.35em" },
      "label_xl":   { "size": 22, "tracking": "0.10em" },
      "label_xxl":  { "size": 24, "tracking": "0.10em" },
      "sublabel":   { "size": 11, "tracking": "0.22em", "color": "{colors.hud_dim}" },
      "number_md":  { "size": 13 },
      "number_lg":  { "size": 18 },
      "number_xl":  { "size": 22 },
      "tiny":       { "size":  9, "tracking": "0.2em" }
    },
    "glow_shadow": "0 0 8px rgba(92,242,255,0.7), 0 0 18px rgba(92,242,255,0.35)"
  },

  "bars": {
    "segments_per_bar": 36,
    "segment_skew_deg": -18,
    "segment_gap": 3,
    "segment_height": 14,
    "fill_thresholds": {
      "danger_below": 30,
      "warn_below":   60,
      "_above_warn":  "ok / hud"
    },
    "danger_pulse_seconds": 0.8
  },

  "weapons": {
    "pulse_cannons": {
      "key": "1",
      "hotkey_label": "1",
      "heat_per_shot": 0.18,
      "heat_decay_per_tick": 0.03,
      "heat_decay_tick_ms": 260,
      "lockout_heat": 0.95,
      "fire_flash_ms": 280,
      "sprite_idle":   "sprites/pulse-cannon-idle.svg",
      "sprite_firing": "sprites/pulse-cannon-firing.svg",
      "projectile": { "color": "{colors.hud}", "stroke_width": 6, "decay_seconds": 0.5, "kind": "beam" }
    },
    "gauss_battery": {
      "key": "2",
      "hotkey_label": "2",
      "mount_count_default": 8,
      "mount_count_range": [3, 8],
      "heat_per_shot": 0.12,
      "heat_decay_per_tick": 0.04,
      "fire_flash_ms": 180,
      "rpm_simulated": 1420,
      "sprite_idle":   "sprites/gauss-turret-idle.svg",
      "sprite_firing": "sprites/gauss-turret-firing.svg",
      "projectile": { "color": "#ffd680", "stroke_width": 2.5, "decay_seconds": 0.35, "kind": "tracer" }
    },
    "torpedoes": {
      "key": "3",
      "hotkey_label": "3",
      "ammo_max": 6,
      "ammo_default": 4,
      "flight_seconds": 1.1,
      "fire_flash_ms": 600,
      "sprite_idle":   "sprites/torpedo-launcher-idle.svg",
      "sprite_firing": "sprites/torpedo-launcher-firing.svg",
      "projectile": { "color": "#e9eef0", "outline": "#ffb14a", "kind": "missile" }
    },
    "shield_parry": {
      "key": "Space",
      "recharge_ms": 2500,
      "ring_segments": 24,
      "outer_tick_count": 36,
      "sprite": "sprites/shield-glyph.svg",
      "pulse_seconds_idle": 3.0
    }
  },

  "animations": {
    "blink":           { "duration_ms": 900,  "loop": true,  "keys": [{ "t": 0, "opacity": 1 }, { "t": 0.5, "opacity": 0.4 }, { "t": 1, "opacity": 1 }] },
    "danger_pulse":    { "duration_ms": 800,  "loop": true,  "keys": [{ "t": 0, "opacity": 1 }, { "t": 0.5, "opacity": 0.55 }, { "t": 1, "opacity": 1 }] },
    "shield_pulse":    { "duration_ms": 3000, "loop": true,  "target": "drop-shadow blur radius 8→14→8" },
    "shield_rotate":   { "duration_ms": 40000,"loop": true,  "target": "rotation 0→360°  (outer tick ring)" },
    "shield_counter":  { "duration_ms": 28000,"loop": true,  "target": "rotation 0→-360° (charge segments)" },
    "minimap_sweep":   { "duration_ms": 5000, "loop": true,  "target": "rotation 0→360° (sweep wedge)" },
    "minimap_ping":    { "duration_ms": 1600, "loop": true,  "target": "scale 0.4→3, opacity 0.9→0" },
    "scan_lines":      { "static": true, "pattern": "repeating-linear-gradient(0deg, rgba(92,242,255,0.025) 0 1px, transparent 1px 3px)" },
    "muzzle_flash":    { "duration_ms": 120,  "loop": "while firing", "target": "opacity 1→0→1" },
    "coil_pulse":      { "duration_ms": 180,  "loop": "while firing", "stagger_ms": 40, "target": "opacity 0.3→1→0.3" },
    "tip_blink":       { "duration_ms": 1200, "loop": true,  "target": "opacity 1→0.3→1" },
    "engine_flicker":  { "duration_ms": 300,  "loop": true,  "target": "opacity 0.5→1→0.5 (enemy engine)" },
    "exhaust_flicker": { "duration_ms": 80,   "loop": "while flying", "target": "opacity 0.4→1→0.4" },
    "drift":           { "duration_ms": 4000, "loop": true,  "target": "translateY -6px, rotate 2deg (enemy contact)" },
    "star_twinkle":    { "duration_ms_range_s": [1.5, 4.5], "loop": true, "target": "opacity o→o*0.2→o (per-star)" }
  },

  "scene": {
    "starfield": { "default_density": 280, "asteroids_density": 180, "star_color": "#cfe6f0" },
    "nebula_gradients": [
      "radial-gradient(circle at 30% 40%, rgba(120, 60, 180, 0.35), transparent 40%)",
      "radial-gradient(circle at 75% 65%, rgba(200, 70, 130, 0.28), transparent 45%)",
      "radial-gradient(circle at 60% 20%, rgba(60, 140, 200, 0.25), transparent 35%)"
    ],
    "asteroid_color":      "#1a2632",
    "asteroid_stroke":     "#2a3a48",
    "asteroid_highlight":  "#26333f",
    "asteroid_shadow":     "#101820",
    "planet_gradient":     "radial-gradient(circle at 35% 30%, #6a8aa0 0%, #2a4a60 40%, #0a1a26 70%, #04101a 100%)"
  },

  "states": {
    "lock_brackets_color": "{colors.danger}",
    "lock_distance_label": "HOSTILE · 2.4 KM",
    "combat_alert_blink_ms": 900
  },

  "files": {
    "sprites": [
      "sprites/pulse-cannon-idle.svg",
      "sprites/pulse-cannon-firing.svg",
      "sprites/gauss-turret-idle.svg",
      "sprites/gauss-turret-firing.svg",
      "sprites/torpedo-launcher-idle.svg",
      "sprites/torpedo-launcher-firing.svg",
      "sprites/torpedo-icon.svg",
      "sprites/shield-glyph.svg",
      "sprites/reticle.svg",
      "sprites/enemy-ship.svg"
    ],
    "tokens": "tokens.json",
    "godot_doc": "GODOT_INTEGRATION.md"
  }
}
